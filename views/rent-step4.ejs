<%
  const p = locals.payment || {};
  const secondsLeft = locals.remainingSeconds || 0;
  const isExpired = !!locals.expired;
  const errorMsg = locals.error || '';
%>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment - Vendoo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=Josefin+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/rent.css" />
    <link rel="stylesheet" href="/css/rent-payment.css" />
</head>

<body>
    <%- include('partials/nav') %>

    <main class="rent">
        <h1 class="rent-title">Rent a spot</h1>

        <%- include('partials/rent-stepper', { current: 4 }) %>

        <form action="/rent/step4" method="POST" enctype="multipart/form-data" class="rent-form" id="pay-form">
            <div class="pay-column">
                <h2 class="block-title">Payment</h2>

                <section class="pay-card" aria-label="Bank transfer details">
                    <p class="pay-line"><%= p.bankName %></p>
                    <p class="pay-line"><%= p.accountName %></p>
                    <p class="pay-line">Bank number: <%= p.accountNumber %></p>

                    <img class="pay-qr" src="<%= p.qrImage || '/images/qr_payment.svg' %>" alt="Payment QR code" width="210" height="210" />

                    <p class="pay-timer<%= isExpired ? ' is-expired' : '' %>" id="countdown" role="timer"
                       data-remaining="<%= secondsLeft %>"><%= String(Math.floor(secondsLeft / 60)).padStart(2, '0') %>:<%= String(secondsLeft % 60).padStart(2, '0') %></p>
                </section>  

                <p class="pay-alert" id="pay-expired" role="alert" <%= isExpired ? '' : 'hidden' %>>
                    Payment time has ended. Please start a new rental.
                </p>

                <div class="attach">
                    <input type="file" id="slip" name="slip" accept="image/png,image/jpeg,image/webp" class="visually-hidden" <%= isExpired ? 'disabled' : '' %> />
                    <label for="slip" class="attach-btn<%= isExpired ? ' is-disabled' : '' %>" id="attach-label">Attach slip</label>
                    <p class="attach-name" id="slip-name" aria-live="polite"></p>
                    <p class="pay-alert" id="slip-error" role="alert" <%= errorMsg ? '' : 'hidden' %>><%= errorMsg %></p>
                </div>

                <div class="pay-note">
                    <p class="pay-note-title"><span class="info-i" aria-hidden="true">i</span> Please note</p>
                    <p>Payment can be made within 1 hour.</p>
                </div>
            </div>

            <div class="rent-actions">
                <a href="<%= locals.backUrl || '/rent/step3' %>" class="btn-back">Back</a>
                <button type="submit" class="btn-next" id="btn-next" <%= isExpired ? 'disabled' : '' %>>Next</button>
            </div>
        </form>
    </main>

    <script src="/js/rent-payment.js"></script>
</body>

</html>
