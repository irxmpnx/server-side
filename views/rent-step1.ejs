<%
  const marketList = locals.markets || [];
  const chosenMarket = locals.selectedMarket || '';
  const chosenDates = (locals.selectedDates || []).join(',');
  const chosenShop = locals.shopName || '';
%>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rent a spot - Vendoo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;500;600;700&family=Josefin+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/rent.css" />
</head>

<body>
    <%- include('partials/nav') %>

    <main class="rent">
        <h1 class="rent-title">Rent a spot</h1>

        <ol class="stepper" aria-label="Rental steps">
            <li class="step is-current" aria-current="step"><span class="dot"></span><span class="step-label">Select market<br />and date</span></li>
            <li class="step"><span class="dot"></span><span class="step-label">Select a spot</span></li>
            <li class="step"><span class="dot"></span><span class="step-label">Confirm detail</span></li>
            <li class="step"><span class="dot"></span><span class="step-label">Payment</span></li>
        </ol>

        <form action="/rent/step1" method="POST" class="rent-form" id="rent-form">
            <div class="rent-column">
                <section class="block">
                    <h2 class="block-title"><label for="market">Select market</label></h2>
                    <div class="select-wrap">
                        <select id="market" name="market_id" required>
                            <option value="" disabled <%= chosenMarket ? '' : 'selected' %>>Choose a market</option>
                            <% marketList.forEach(function (m) { %>
                            <option value="<%= m.id %>" <%= String(m.id) === String(chosenMarket) ? 'selected' : '' %>><%= m.name %></option>
                            <% }) %>
                        </select>
                    </div>
                </section>

                <section class="block">
                    <h2 class="block-title"><label for="shop_name">Shop name</label></h2>
                    <input type="text" id="shop_name" name="shop_name" class="text-input"
                           placeholder="Enter shop name" maxlength="150" autocomplete="off"
                           value="<%= chosenShop %>" required />
                </section>

                <section class="block">
                    <h2 class="block-title" id="date-heading">Select date</h2>

                    <div class="calendar" id="calendar" role="group" aria-labelledby="date-heading">
                        <div class="cal-head">
                            <button type="button" class="cal-nav" id="cal-prev" aria-label="Previous month">&lt;</button>
                            <p class="cal-title" id="cal-title" aria-live="polite"></p>
                            <button type="button" class="cal-nav" id="cal-next" aria-label="Next month">&gt;</button>
                        </div>
                        <div class="cal-weekdays" aria-hidden="true">
                            <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
                        </div>
                        <div class="cal-grid" id="cal-grid"></div>
                    </div>

                    <div class="cal-summary">
                        <p id="cal-summary" aria-live="polite">Pick one or more days. They don't have to be consecutive.</p>
                        <button type="button" class="link-clear" id="cal-clear" hidden>Clear dates</button>
                    </div>

                    <input type="hidden" name="dates" id="dates" value="<%= chosenDates %>" />
                </section>
            </div>

            <div class="rent-actions">
                <button type="submit" class="btn-next" id="btn-next" disabled>Next</button>
            </div>
        </form>
    </main>

    <script src="/js/rent-step1.js"></script>
</body>

</html>
