<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Add a Market - Step 1</title>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Josefin+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/owner.css" />
</head>
<body>
  <%- include('../partials/nav') %>

  <main class="wizard-container">
    <h1 class="wizard-title">Add a market</h1>

    <!-- Single Continuous Line Behind Stepper Circles -->
    <div class="stepper" style="--progress: 0%;">
      <div class="step active"><span class="dot"></span><small>Market details</small></div>
      <div class="step"><span class="dot"></span><small>Operating day</small></div>
      <div class="step"><span class="dot"></span><small>Market map</small></div>
      <div class="step"><span class="dot"></span><small>Verify</small></div>
    </div>

    <form action="/owner/markets/new/step-1" method="POST" enctype="multipart/form-data" class="wizard-form">
      <h2 class="section-bar-title">Market details</h2>

      <div class="grid-2">
        <div class="form-group">
          <label>Market name</label>
          <input type="text" name="name" placeholder="e.g. Central Night Market" value="<%= draft.name || '' %>" required />
        </div>
        <div class="form-group">
          <label>Genre</label>
          <select name="genre" required>
            <option value="">Select genre</option>
            <option value="Night Market" <%= draft.genre === 'Night Market' ? 'selected' : '' %>>Night Market</option>
            <option value="Flea Market" <%= draft.genre === 'Flea Market' ? 'selected' : '' %>>Flea Market</option>
            <option value="Food Market" <%= draft.genre === 'Food Market' ? 'selected' : '' %>>Food Market</option>
            <option value="Community Market" <%= draft.genre === 'Community Market' ? 'selected' : '' %>>Community Market</option>
          </select>
        </div>
      </div>

      <div class="grid-2">
        <div class="form-group">
          <label>Location</label>
          <input type="text" name="location" placeholder="Street, District, City" value="<%= draft.location || '' %>" required />
        </div>
        <div class="form-group">
          <label>Phone number</label>
          <input type="tel" name="phone_number" placeholder="08xxxxxxxx" value="<%= draft.phone_number || '' %>" required />
        </div>
      </div>

      <div class="form-group">
        <label>Description</label>
        <textarea name="description" rows="4" placeholder="Describe your market, rules, or highlights..."><%= draft.description || '' %></textarea>
      </div>

      <!-- Multiple File Upload + Main Cover Selector -->
      <div class="form-group">
        <label>Images (Choose multiple files &amp; select Main Cover)</label>
        <label class="upload-box" for="marketImagesInput">
          <span class="upload-title">Click to upload photos from your computer</span>
          <small class="upload-hint">Supports JPG, PNG, WEBP (up to 10 photos)</small>
          <input type="file" id="marketImagesInput" name="market_images" accept="image/*" multiple hidden />
        </label>

        <input type="hidden" name="main_image_index" id="mainImageIndex" value="0" />
        <div class="image-preview-grid" id="imagePreviewGrid">
          <% if (draft.image_urls && draft.image_urls.length > 0) { %>
            <% draft.image_urls.forEach((url, idx) => { %>
              <div class="preview-card <%= idx === 0 ? 'is-main' : '' %>" onclick="selectMainImage(<%= idx %>, this)">
                <img src="<%= url %>" alt="Market photo" />
                <span class="main-badge"><%= idx === 0 ? 'Main Cover' : 'Set as Main' %></span>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>

      <h2 class="section-bar-title" style="margin-top: 32px;">Payment account details</h2>

      <div class="grid-2">
        <div class="form-group">
          <label>Bank name</label>
          <select name="bank_name" required>
            <option value="">Select bank</option>
            <option value="Kasikornbank (KBank)" <%= draft.bank_name === 'Kasikornbank (KBank)' ? 'selected' : '' %>>Kasikornbank (KBank)</option>
            <option value="SCB" <%= draft.bank_name === 'SCB' ? 'selected' : '' %>>SCB</option>
            <option value="Bangkok Bank" <%= draft.bank_name === 'Bangkok Bank' ? 'selected' : '' %>>Bangkok Bank</option>
            <option value="Krungthai Bank" <%= draft.bank_name === 'Krungthai Bank' ? 'selected' : '' %>>Krungthai Bank</option>
            <option value="PromptPay" <%= draft.bank_name === 'PromptPay' ? 'selected' : '' %>>PromptPay</option>
          </select>
        </div>
        <div class="form-group">
          <label>Bank account / PromptPay number</label>
          <input type="text" name="bank_account_number" placeholder="xxx-x-xxxxx-x" value="<%= draft.bank_account_number || '' %>" required />
        </div>
      </div>

      <div class="wizard-footer end">
        <button type="submit" class="btn-yellow">Next</button>
      </div>
    </form>
  </main>

  <script>
    const fileInput = document.getElementById('marketImagesInput');
    const previewGrid = document.getElementById('imagePreviewGrid');
    const mainIndexInput = document.getElementById('mainImageIndex');

    function selectMainImage(index, cardEl) {
      mainIndexInput.value = index;
      document.querySelectorAll('.preview-card').forEach((card) => {
        card.classList.remove('is-main');
        card.querySelector('.main-badge').textContent = 'Set as Main';
      });
      cardEl.classList.add('is-main');
      cardEl.querySelector('.main-badge').textContent = 'Main Cover';
    }

    fileInput.addEventListener('change', (e) => {
      previewGrid.innerHTML = '';
      mainIndexInput.value = 0;
      const files = Array.from(e.target.files);

      files.forEach((file, idx) => {
        const reader = new FileReader();
        reader.onload = (ev) => {
          const card = document.createElement('div');
          card.className = 'preview-card' + (idx === 0 ? ' is-main' : '');
          card.innerHTML = `
            <img src="${ev.target.result}" alt="Preview ${idx + 1}" />
            <span class="main-badge">${idx === 0 ? 'Main Cover' : 'Set as Main'}</span>
          `;
          card.onclick = () => selectMainImage(idx, card);
          previewGrid.appendChild(card);
        };
        reader.readAsDataURL(file);
      });
    });
  </script>
</body>
</html>