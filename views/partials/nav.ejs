    <a href="/#about">About</a>
    <a href="/#faq">FAQ</a>
    <a href="/#contact">Contact</a>
  </nav>
  <div class="nav-auth">
    <% if (currentUser) { %>
      <a href="/welcome" class="nav-signin">Dashboard</a>
