<header class="navbar">
    <a href="/"><img src="/images/logo.svg" class="nav-logo" alt="Logo" /></a>
    <nav class="nav-links">
        <a href="/#about">About</a>
        <a href="/#faq">FAQ</a>
        <a href="/#contact">Contact</a>
    </nav>
    <div class="nav-auth">
        <% if (currentUser) { %>
        <button type="button" class="nav-signin nav-user-btn" id="sidebar-trigger"
                aria-controls="user-sidebar" aria-expanded="false"><%= currentUser.username %></button>
        <% } else { %>
        <a href="/signin" class="nav-signin">Sign in</a>
        <% } %>
    </div>
</header>

<% if (currentUser) { %>
<link rel="stylesheet" href="/css/sidebar.css" />

<div class="sidebar-backdrop" id="sidebar-backdrop"></div>

<aside class="sidebar" id="user-sidebar" aria-label="User menu">
    <div class="sidebar-head">
        <button type="button" class="sidebar-close" id="sidebar-close" aria-label="Close menu"><%= currentUser.username %></button>
    </div>

    <nav class="sidebar-nav" aria-label="Account">
        <a href="/rent/step1">Rent a spot</a>
        <a href="/myRental">My Rental</a>
        <a href="/myFavorite">My Favorite</a>
    </nav>

    <form action="/logout" method="POST" class="sidebar-logout">
        <button type="submit">Log out</button>
    </form>
</aside>

<script src="/js/sidebar.js" defer></script>
<% } %>
